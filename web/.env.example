# Live data: uncomment these three lines to proxy a local Freqtrade API.
# Leave them unset to boot the deterministic demo dashboard.
# FREQTRADE_API_URL=http://127.0.0.1:8080
# FREQTRADE_USERNAME=freqtrader
# FREQTRADE_PASSWORD=change-me

# Dashboard login. Required for any network-accessible deployment.
# Generate the secret with: openssl rand -hex 32
# DASHBOARD_PASSWORD=change-me
# DASHBOARD_SECRET=replace-with-a-long-random-secret

# Local-only escape hatch. Never enable this on a public deployment.
# DASHBOARD_AUTH_DISABLED=1

# Optional: published loopback port for `docker compose --profile web up`
# WEB_PORT=3000
